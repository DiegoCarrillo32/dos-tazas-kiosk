{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(pos)/layout,_N_T_/(pos)/counter/layout,_N_T_/(pos)/counter/page,_N_T_/counter"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KHBvcyk/counter/__PAGE__",
    "/!KHBvcyk/counter",
    "/!KHBvcyk",
    "/_index",
    "/_head"
  ]
}